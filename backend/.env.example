# Copy to backend/.env. Every key is optional: without it the matching agent uses its built-in rules.
CORS_ORIGINS=http://localhost:3000

# Claude for the agents (CV parsing, interviewer follow-ups, Genie, report summary)
ANTHROPIC_API_KEY=
SAARATHI_MODEL=claude-opus-5-5

# Job APIs (official only, never scraping). Remotive and Arbeitnow need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FETCH_LIVE_JOBS=true

# YouTube Data API for live lecture search when the catalogue has nothing in the user's language
YOUTUBE_API_KEY=

# n8n webhook that delivers email/WhatsApp notifications ({user, channel, template, data})
N8N_WEBHOOK_URL=

# Shared secret Vercel Cron sends as "Authorization: Bearer <secret>" to /cron/daily
CRON_SECRET=
