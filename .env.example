# FastAPI backend (agents built in AgentFoundry run behind this)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Supabase (public anon key only — never put LLM keys here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "false" once the backend is live; "true" uses lib/mock.ts
NEXT_PUBLIC_USE_MOCKS=true
